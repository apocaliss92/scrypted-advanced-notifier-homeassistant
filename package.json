{
  "name": "scrypted-advanced-notifier-homeassistant",
  "version": "1.0.27",
  "private": true,
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "docs:generate": "python3 scripts/docs_generate.py",
    "docs:check": "python3 scripts/docs_generate.py --check && python3 scripts/docs_check_refs.py",
    "docs:install": "npm --prefix docs install",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build"
  }
}
