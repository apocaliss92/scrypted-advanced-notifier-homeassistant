# syntax=docker/dockerfile:1
# =============================================================================
# Docs site — static render of `docs/`, for Railway (or any container host).
#
# This repository ships a Home Assistant custom integration, which is installed
# from source by HACS and has no image of its own. `Dockerfile.docs` is therefore
# the only Dockerfile here, and it builds ONLY the documentation — it must never
# grow into an app image.
#
# The site is a VIEW over `docs/`. There is no editing surface here and there must
# never be one: the repository stays the single place documentation is written.
#
# Railway: set the service's `RAILWAY_DOCKERFILE_PATH=Dockerfile.docs`. Railway
# injects `PORT`; Caddy reads it.
# =============================================================================

# ── Build ────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS build

WORKDIR /src

# Pinned so a docs deploy is reproducible and cannot break on an upstream
# release. Bump deliberately, together with the pin in
# .github/workflows/docs-deploy.yml.
RUN pip install --no-cache-dir mkdocs-material==9.5.49

# `mkdocs.yml` has no `nav:` block — navigation is derived from the directory
# tree, so adding a page needs no config change.
COPY mkdocs.yml ./
COPY docs/ ./docs/

# `--strict` fails the build on a broken internal link: a deploy that would
# publish a broken site does not deploy.
RUN mkdocs build --strict

# ── Serve ────────────────────────────────────────────────────────────────────
FROM caddy:2.8-alpine

COPY --from=build /src/site /srv/site
COPY docker/docs.Caddyfile /etc/caddy/Caddyfile
COPY docker/docs-entrypoint.sh /usr/local/bin/docs-entrypoint.sh
RUN chmod +x /usr/local/bin/docs-entrypoint.sh

# Railway overrides this. The default keeps `docker run -p 8080:8080` working.
ENV PORT=8080
EXPOSE 8080

# `/_health` is the one path left unauthenticated, so this works in both the
# public and the password-protected configuration.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- "http://127.0.0.1:${PORT}/_health" >/dev/null || exit 1

# The entrypoint decides public vs password-protected, then execs Caddy. It exits
# 1 rather than guessing — see docker/docs-entrypoint.sh.
ENTRYPOINT ["/usr/local/bin/docs-entrypoint.sh"]
